# Servidor do site estatico.
#
# Sem este arquivo o Railpack gera um Caddyfile cujo try_files e
# `{path} {path}.html {path}/index.html`. Para a raiz isso vira `/`, `/.html`
# e `//index.html` — nenhum casa, e a home responde 404 enquanto
# /index.html responde 200. O `/index.html` no fim da lista fecha esse buraco.
#
# Fixar o arquivo aqui tambem torna o comportamento deterministico: nao muda
# quando a versao do gerador muda.

:{$PORT:80} {
	root * .

	encode gzip zstd

	try_files {path} {path}.html {path}/index.html /index.html

	file_server {
		hide .git
		hide .env*
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
